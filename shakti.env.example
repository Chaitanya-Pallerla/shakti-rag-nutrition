# =====================================================================================================
# SHAKTI settings: ALL your paths and API keys in one place.
#
#   1. Copy this file to  shakti.env   (same folder)
#   2. Paste your values after the = signs. Leave a value empty to keep the default.
#   3. Done. Every script reads shakti.env automatically (shakti_config.py).
#
# shakti.env is listed in .gitignore, so your keys and paths are never pushed to GitHub.
# Check what was loaded (keys are masked):   python shakti_config.py
# Relative paths below are relative to this folder. Windows paths work as-is (D:\data\shakti_research).
# =====================================================================================================

# ----------------------------------------------------------------------------- 1. folders (paths)
# Research data: OpenAlex snapshot, MiniLM / SPECTER2 vectors, benchmark runs, chat logs.
# Needs ~1.4 TB for the full corpus (see README "Data"); only the serving index is needed to chat.
SHAKTI_RESEARCH_DIR=shakti_research

# Compact PQ search index used by the chat server (~113 GB). Put it on a fast SSD/NVMe.
SHAKTI_SERVE_INDEX=shakti_serve_index

# USDA FoodData Central as DuckDB (build with: python build_food_db.py <unzipped FDC csv folder>)
SHAKTI_FOOD_DB=food.duckdb

# Local model folders: models/medcpt-cross-encoder and models/specter2 (see README "Models")
SHAKTI_MODELS_DIR=models

# Optional: where Hugging Face caches downloads (all-MiniLM-L6-v2 etc.). Empty = the HF default.
HF_HOME=

# Optional: Python executables for the two environments (empty = the Python running the script).
# Needed only for the retrieval benchmark, which calls the SPECTER2 environment as a subprocess.
SHAKTI_PY_MAIN=
SHAKTI_PY_SPECTER2=

# ----------------------------------------------------------------------------- 2. language model
# Which LLM writes the answers:
#   claude = Claude Code CLI, signed in with your Claude account (no key needed) or ANTHROPIC_API_KEY below
#   codex  = OpenAI Codex CLI, signed in with your ChatGPT account (no key needed) or OPENAI_API_KEY below
#   openai = any OpenAI-compatible server: Ollama / vLLM / LM Studio / llama.cpp (offline, e.g. Qwen2.5-VL)
#            or the OpenAI API itself
SHAKTI_LLM_BACKEND=claude

# Model names for codex / openai backends (the claude backend uses sonnet / opus / haiku directly).
#   Ollama example:  qwen2.5vl:7b        vLLM example:  Qwen/Qwen2.5-VL-7B-Instruct
#   OpenAI example:  gpt-5               Codex example: gpt-5
SHAKTI_LLM_MODEL=
# Optional, a different (stronger) model for the evaluation judge:
SHAKTI_LLM_MODEL_OPUS=

# Server address for the openai backend (must end in /v1)
#   Ollama: http://127.0.0.1:11434/v1   vLLM: http://127.0.0.1:8000/v1   LM Studio: http://127.0.0.1:1234/v1
#   OpenAI: https://api.openai.com/v1
SHAKTI_OPENAI_BASE_URL=http://127.0.0.1:11434/v1

# Set to 0 if your local server rejects JSON-schema structured output (the prompt then asks for JSON)
SHAKTI_OPENAI_JSON_SCHEMA=1
SHAKTI_LLM_TEMPERATURE=0

# ----------------------------------------------------------------------------- 3. API keys (optional)
# Not needed when you sign in to the Claude Code CLI / Codex CLI, or for local models.
# Claude Code CLI uses this instead of a sign-in if set:
ANTHROPIC_API_KEY=
# OpenAI API, or Codex CLI with an API key:
OPENAI_API_KEY=
# A key for your own OpenAI-compatible server, if it needs one (vLLM --api-key, hosted gateways):
SHAKTI_OPENAI_API_KEY=
# Hugging Face token, only if a model download asks for one:
HF_TOKEN=

# ----------------------------------------------------------------------------- 4. chat server
# Seconds before a model call counts as stalled and is retried. Local models are slower: try 300 / 600.
SHAKTI_T_STEP=60
SHAKTI_T_ANSWER=90
SHAKTI_MAX_TURNS=20
SHAKTI_DAILY_CAP=300

# MCP server (mcp_server.py) -> where the chat server runs
SHAKTI_URL=http://127.0.0.1:8780
SHAKTI_MCP_TIMEOUT=600

# ----------------------------------------------------------------------------- 5. benchmark runs
RAG_MODEL=sonnet
RAG_JUDGE_MODEL=sonnet
RAG_WORKERS=
SHAKTI_WORKERS=3
